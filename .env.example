# Supabase (클라이언트에 노출되어도 안전한 anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API (서버 전용 — Vercel Functions에서만 사용, VITE_ 접두사 사용 금지)
GEMINI_API_KEY=

# Supabase service_role 키 (서버 전용, RLS 우회 — 리마인더 대상 조회용. 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron 요청 검증용 (설정하면 Vercel이 자동으로 Authorization 헤더에 실어서 보내줌)
CRON_SECRET=
